(kichad_design (version 1) (project "Doorbell_PS" (title "8-24VAC 15W Doorbell Camera UPS") (revision "A0") (date "2026-07-28") (comment 1 "Isolated Class-2 30VA input; 7VDC 15W output; 30s minimum backup") (comment 2 "1S LiFePO4 with NTC-qualified 500mA charging; 0-50C operation") (comment 3 "External transformer (not PCB-mounted): NSI/TORK TA598 tri-tap; PCB accepts isolated 8/16/24VAC secondary only; use 24VAC tap for rated 15W operation")) (units mm)
(library symbol Device (table global))
(library symbol Connector_Generic (table global))
(library symbol Connector (table global))
(library footprint TerminalBlock_Phoenix (table global))
(library footprint Fuse (table global))
(library footprint Diode_SMD (table global))
(library footprint Diode_THT (table global))
(library footprint Capacitor_THT (table global))
(library footprint Capacitor_SMD (table global))
(library footprint Resistor_SMD (table global))
(library footprint Resistor_THT (table global))
(library footprint Inductor_SMD (table global))
(library footprint Package_TO_SOT_SMD (table global))
(library footprint Package_DFN_QFN (table global))
(library footprint Package_SON (table global))
(library footprint Package_SO (table global))
(library footprint Doorbell_PS (table project) (uri "${KIPRJMOD}/Doorbell_PS.pretty") (managed true))
(library symbol KiChad (table project) (uri "${KIPRJMOD}/KiChad.kicad_sym") (managed true))
