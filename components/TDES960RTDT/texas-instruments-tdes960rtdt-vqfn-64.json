      { "3": "10uf-dvss" },
      { "45": "mode" },
      { "45c": "MODE strap 0 = CSI-2 mode: RHIGH open, RLOW 10k (Table 7-1)." },
      { "45": "10k-dvss" },
      { "46": "idx" },
      { "46c": "IDX strap 0 = I2C address 0x30 (7-bit): RHIGH open, RLOW 10k (Table 7-17)." },
      { "46": "10k-dvss" },
      { "4": "res" },
      { "4c": "Reserved: tie to GND for normal operation." },
      { "4": "dvss" },
      { "5": "refclk" },
      { "5c": "Reference clock: a 23-26 MHz LVCMOS oscillator (100 ppm); 25 MHz for 400/800/1200/1600 Mbps CSI-2 rates. Required." },
      { "6": "intb" },
      { "6c": "Interrupt, open drain: 4.7k pull-up to VDDIO when used; if unused leave open." },
      { "56": "cmloutp" },
      { "56c": "Channel-monitor loop-through output: 100 ohm between CMLOUTP and CMLOUTN (recommended)." },
      { "56": "100r-cmloutn" },
      { "7": "i2c_sda2" },
      { "7c": "Secondary I2C data: 2.2k-4.7k pull-up to VDDIO recommended." },
      { "7": "4.7k-vddio" },
      { "8": "i2c_scl2" },
      { "8c": "Secondary I2C clock: 2.2k-4.7k pull-up to VDDIO recommended." },
      { "8": "4.7k-vddio" },
      { "34c": "CSI-2 TX port 1 (pins 34-43): the second camera's output port, to the second CSI-2 receiver; untagged like the MAX96716's port B until the design has a second-port convention." },
      { "50c": "RIN0+..RIN3+: 33-100 nF (50 V X7R 0402) AC-coupling capacitor in series to each coax connector (Table 8-4); a series part, not a pin passive. RINx- get 15-47 nF + 49.9 ohm to GND for single-ended coax, used or not." },
