    "cfgpins-ao": [
      { "3": "pdb" },
      { "3c": "Power-down, active low (internal 50k pulldown, 3.3 V tolerant); must stay low until the supplies are up. Tied up for power-on enable with an RC: 10k to VDDIO and 10 uF to GND (or drive from a host GPIO)." },
